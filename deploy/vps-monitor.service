[Unit]
Description=VPS Monitor
After=network.target

[Service]
Type=simple
User=vpsmonitor
WorkingDirectory=/opt/vps-monitor
EnvironmentFile=/etc/vps-monitor.env
Environment=HOST=127.0.0.1
Environment=PORT=4173
ExecStart=/usr/bin/node /opt/vps-monitor/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
